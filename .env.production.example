# Settings for docker-compose.prod.yml. Copy to .env.production (git-ignored), fill in every
# CHANGE-ME, and keep it private. Use letters and digits only in the secrets: Docker Compose
# treats "$" specially.
#   Secret key:  python3 -c "import secrets; print(secrets.token_urlsafe(50).replace('-', 'x'))"
#   Passwords:   openssl rand -hex 24

# --- Your address -------------------------------------------------------------------------
# The domain pointing at the server (an A record for its IP). Caddy gets the HTTPS certificate
# for it. Use "localhost" to try the stack on your own computer (self-signed certificate).
SITE_ADDRESS=demo.example.com
DJANGO_ALLOWED_HOSTS=demo.example.com
CSRF_TRUSTED_ORIGINS=https://demo.example.com
SITE_URL=https://demo.example.com
APP_BASE_URL=https://demo.example.com

# --- Django -------------------------------------------------------------------------------
DJANGO_SECRET_KEY=CHANGE-ME
DJANGO_DEBUG=False
DJANGO_SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
# One reverse proxy (Caddy) in front of the app.
TRUSTED_PROXY_COUNT=1
# Once HTTPS works, 3600 (an hour) and later 31536000 (a year). 0 = off.
SECURE_HSTS_SECONDS=0
TIME_ZONE=UTC
SITE_NAME=BookCRM

# --- Database (the db container is created with these) ------------------------------------
POSTGRES_DB=bookcrm
POSTGRES_USER=bookcrm
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Same user and password as above.
DATABASE_URL=postgres://bookcrm:CHANGE-ME@db:5432/bookcrm

# --- Redis (internal only) ----------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- Email --------------------------------------------------------------------------------
# The console backend writes emails to the logs (docker compose logs web celery) instead of
# sending them. For real email, use an SMTP provider:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@demo.example.com

# --- Optional -----------------------------------------------------------------------------
# Gunicorn processes (about 2 per CPU core).
WEB_WORKERS=3
# Other ports on the host, e.g. when testing locally next to other services.
# HTTP_PORT=80
# HTTPS_PORT=443
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
