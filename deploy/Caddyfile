# The public entrance for docker-compose.prod.yml. Caddy gets and renews the HTTPS
# certificate for SITE_ADDRESS (a domain pointing at this server) and passes requests on to
# the app. With SITE_ADDRESS=localhost it uses its own local certificate (for testing).

{$SITE_ADDRESS} {
	encode zstd gzip

	# Optional password for the whole site, e.g. while a partner reviews a demo.
	# See docs/DEPLOY_HETZNER.md; with no *.caddy file in deploy/auth/ this does nothing.
	import /etc/caddy/auth/*.caddy

	# Uploaded files (logos, photos) straight from the shared volume. Never run as a page.
	handle_path /media/* {
		root * /srv/media
		header {
			X-Content-Type-Options nosniff
			Content-Security-Policy "default-src 'none'; sandbox"
		}
		file_server
	}

	# Everything else, static files included (WhiteNoise), goes to the app. Caddy replaces any
	# X-Forwarded-For / X-Forwarded-Proto the client sent, so Django can trust one proxy.
	handle {
		reverse_proxy web:8000 {
			header_down -Server
		}
	}

	log {
		output stdout
		format console
	}
}
